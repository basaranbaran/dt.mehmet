</a>

<script>
  // ========================================================================
  // 1. Canlı Açık / Kapalı Hesaplayıcı (Europe/Istanbul)
  // ========================================================================
  function calculateClinicOpenStatus() {
    const badge = document.getElementById('contactLiveStatusBadge');
    const text = document.getElementById('contactLiveStatusText');
    const navBadge = document.getElementById('navbarLiveStatusBadge');
    const navText = document.getElementById('navbarLiveStatusText');
    if (!badge || !text) return;

    try {
      const now = new Date();
      // Türkiye saatine çevir
      const trDate = new Date(now.toLocaleString('en-US', { timeZone: 'Europe/Istanbul' }));
      const day = trDate.getDay(); // 0: Pazar, 1: Pzt, ..., 6: Cts
      const hours = trDate.getHours();
      const minutes = trDate.getMinutes();
      const currentMins = hours * 60 + minutes;

      const openMins = 8 * 60;   // 08:00
      const closeMins = 20 * 60; // 20:00

      let isOpen = false;
      let statusStr = '';

      if (day === 0) {
        // Pazar: Kapalı
        isOpen = false;
        statusStr = 'Şu an Kapalı (Pzt 08:00 Açılıyor)';
      } else {
        // Pazartesi — Cumartesi
        if (currentMins >= openMins && currentMins < closeMins) {
          isOpen = true;
          statusStr = 'Şu an Açık (20:00\'ye kadar)';
        } else if (currentMins < openMins) {
          isOpen = false;
          statusStr = 'Şu an Kapalı (Bugün 08:00 Açılıyor)';
        } else {
          isOpen = false;
          statusStr = day === 6 ? 'Şu an Kapalı (Pzt 08:00 Açılıyor)' : 'Şu an Kapalı (Yarın 08:00 Açılıyor)';
        }
      }

      text.textContent = statusStr;
      if (isOpen) {
        badge.className = 'inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold border transition-colors bg-emerald-50 text-emerald-800 border-emerald-200';
        badge.querySelector('span')?.classList.remove('bg-rose-500');
        badge.querySelector('span')?.classList.add('bg-emerald-500');
      } else {
        badge.className = 'inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold border transition-colors bg-rose-50 text-rose-800 border-rose-200';
        badge.querySelector('span')?.classList.remove('bg-emerald-500');
        badge.querySelector('span')?.classList.add('bg-rose-500');
      }

      if (navBadge && navText) {
        navText.textContent = isOpen ? 'Şu an Açık (08:00-20:00)' : 'Şu an Kapalı';
        if (isOpen) {
          navBadge.className = 'hidden xl:flex items-center space-x-1.5 px-3 py-1 rounded-full text-[11px] font-bold border bg-emerald-50 text-emerald-800 border-emerald-200';
        } else {
          navBadge.className = 'hidden xl:flex items-center space-x-1.5 px-3 py-1 rounded-full text-[11px] font-bold border bg-rose-50 text-rose-800 border-rose-200';
        }
      }
    } catch (e) {
      console.error(e);
    }
  }

  // ========================================================================
  // 2. E-Posta AJAX Formu (FormSubmit.co ile admin panelinden ayarlanan
  //    e-posta adresine gönderim — form[data-recipient] üzerinden okunur)
  // ========================================================================
  const form = document.getElementById('contact-form-element') as HTMLFormElement;
  const successMsg = document.getElementById('form-success-message');
  const errorMsg = document.getElementById('form-error-message');
  const btnSubmitText = document.getElementById('btnSubmitText');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');

    const name = (document.getElementById('form-name') as HTMLInputElement)?.value;
    const phone = (document.getElementById('form-phone') as HTMLInputElement)?.value;
    const email = (document.getElementById('form-email') as HTMLInputElement)?.value;
    const message = (document.getElementById('form-message') as HTMLTextAreaElement)?.value;
    const recipient = form.dataset.recipient || 'dt.mehmetyagci@gmail.com';

    if (btnSubmitText) btnSubmitText.textContent = 'Gönderiliyor...';

    try {
      const response = await fetch(`https://formsubmit.co/ajax/${recipient}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          _subject: `Yeni Randevu / Mesaj Talebi: ${name}`,
          _template: 'table',
          _captcha: 'false',
          'Ad Soyad': name,
          'Telefon': phone,
          'E-Posta': email,
          'Mesaj': message,
          'Tarih': new Date().toLocaleString('tr-TR', { timeZone: 'Europe/Istanbul' })
        })
      });

      if (response.ok) {
        successMsg?.classList.remove('hidden');
        form.reset();
      } else {
        errorMsg?.classList.remove('hidden');
      }
    } catch (err) {
      console.error(err);
      errorMsg?.classList.remove('hidden');
    } finally {
      if (btnSubmitText) btnSubmitText.textContent = 'E-Posta Olarak Gönder';
    }
  });

  // Sayfa yüklendiğinde ve her dakika çalışma durumunu güncelle
  calculateClinicOpenStatus();
  setInterval(calculateClinicOpenStatus, 60000);
</script>
