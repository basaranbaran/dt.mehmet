---
import { clinicConfig } from '../config.js';

const { config = clinicConfig } = Astro.props;
const { contact, contactHeading } = config;

// Google Maps iframe veya direkt URL desteği
const cleanMapsUrl = (raw: string) => {
  if (!raw) return 'https://maps.google.com/maps?q=Dt.+Mehmet+Ya%C4%9Fc%C4%B1+A%C4%9F%C4%B1z+ve+Di%C5%9F+Sa%C4%9Fl%C4%B1%C4%9F%C4%B1+Klini%C4%9Fi+Nazilli&t=&z=16&ie=UTF8&iwloc=&output=embed';
  const match = raw.match(/src=["']([^"']+)["']/);
  if (match) return match[1];
  return raw.split('"')[0].split("'")[0];
};

const mapUrl = cleanMapsUrl(contact.googleMapsEmbedUrl);
const directionsUrl = contact.googleMapsShareUrl || contact.googleMapsDirectionsUrl || 'https://share.google/YQ6vVbmg2UtP1O5TT';

const doctorName = contact.doctorName || 'Mehmet YAĞCI';
const whatsappMessage = encodeURIComponent(`Merhaba ${doctorName}, randevu almak istiyorum.`);
const whatsappUrl = `https://wa.me/${contact.phoneClean || '905305084484'}?text=${whatsappMessage}`;
const recipientEmail = contact.email || 'dt.mehmetyagci@gmail.com';
---

<section id="iletisim" class="py-20 bg-brand-light relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Başlık -->
    <div class="section-heading text-center max-w-2xl mx-auto mb-16">
      <span class="text-xs sm:text-sm font-bold text-brand-primary uppercase tracking-widest font-display">
        {contactHeading?.title || 'İletişim & Randevu'}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight font-display mt-2">
        {contactHeading?.subtitle || 'Randevu & Bize Ulaşın'}
      </h2>
      <div class="w-12 h-1 bg-brand-primary mx-auto mt-4 rounded-full"></div>
      <p class="mt-4 text-brand-muted text-sm sm:text-base">
        {contactHeading?.description || 'Kliniğimizden randevu almak için WhatsApp üzerinden doğrudan bize yazabilir veya telefon numaralarımızdan hemen ulaşabilirsiniz.'}
      </p>
    </div>

    <!-- Satır 1: Klinik Bilgileri (sol) + Google Harita (sağ) — eşit yükseklikte eşleşen çift -->
    <div class="contact-info-col grid lg:grid-cols-2 gap-8 items-stretch">

      <!-- Klinik Bilgileri Kartı -->
      <div class="bg-white rounded-3xl p-6 sm:p-7 shadow-xl border border-gray-100 flex flex-col space-y-5 h-full">
        <div class="flex items-center justify-between border-b border-gray-100 pb-4">
          <div>
            <span class="text-[11px] font-bold tracking-widest uppercase text-brand-primary font-display">
              {contactHeading?.infoTitle || 'Klinik Detayları'}
            </span>
            <h3 class="text-xl font-bold text-brand-dark font-display">{doctorName}</h3>
          </div>
          <span class="text-xs bg-emerald-50 text-emerald-700 font-bold px-3 py-1 rounded-full border border-emerald-200/80">
            Nazilli Kliniği
          </span>
        </div>

        <!-- Mobil & WhatsApp -->
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center space-x-4 p-3.5 rounded-2xl bg-emerald-50/70 border border-emerald-200/60 hover:bg-emerald-100/70 transition-all hover:shadow-sm group"
        >
          <div class="w-11 h-11 bg-emerald-500 text-white rounded-xl shadow-md flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6 fill-current" viewBox="0 0 448 512" aria-hidden="true">
              <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
            </svg>
          </div>
          <div class="flex-1">
            <span class="text-[10px] font-bold text-emerald-800 uppercase tracking-wider block">WhatsApp &amp; Cep Telefonu</span>
            <span class="text-sm sm:text-base font-bold text-emerald-950 block">{contact.phone || '+90 (530) 508 44 84'}</span>
          </div>
          <span class="text-xs font-bold text-emerald-700 bg-white px-2.5 py-1 rounded-lg shadow-2xs">Mesaj Yaz ↗</span>
        </a>

        <!-- Sabit Klinik Telefonu -->
        <a
          href={`tel:${contact.landlineClean || '02563134884'}`}
          class="flex items-center space-x-4 p-3.5 rounded-2xl bg-gray-50/80 border border-gray-100 hover:bg-brand-light/50 transition-all hover:shadow-sm group"
        >
          <div class="w-11 h-11 bg-brand-primary text-white rounded-xl shadow-sm flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <div class="flex-1">
            <span class="text-[10px] font-bold text-brand-muted uppercase tracking-wider block">Klinik Sabit Hattı</span>
            <span class="text-sm sm:text-base font-bold text-brand-dark block">{contact.landlinePhone || '0 (256) 313 48 84'}</span>
          </div>
          <span class="text-xs font-semibold text-brand-primary">Ara</span>
        </a>

        <!-- E-Posta -->
        <a
          href={`mailto:${contact.email}`}
          class="flex items-center space-x-4 p-3.5 rounded-2xl bg-gray-50/80 border border-gray-100 hover:bg-brand-light/50 transition-all hover:shadow-sm group"
        >
          <div class="w-11 h-11 bg-brand-accent text-brand-dark rounded-xl shadow-sm flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <span class="text-[10px] font-bold text-brand-muted uppercase tracking-wider block">E-Posta Adresi</span>
            <span class="text-xs sm:text-sm font-bold text-brand-dark truncate block">{contact.email}</span>
          </div>
        </a>

        <!-- Açık Adres -->
        <div class="flex items-start space-x-4 p-3.5 rounded-2xl bg-gray-50/80 border border-gray-100">
          <div class="w-11 h-11 bg-rose-50 text-rose-600 rounded-xl shadow-sm flex items-center justify-center shrink-0 mt-0.5 border border-rose-100">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div>
            <span class="text-[10px] font-bold text-brand-muted uppercase tracking-wider block">Klinik Adresi</span>
            <p class="text-xs sm:text-sm font-semibold text-brand-dark mt-0.5 leading-relaxed">
              {contact.address || 'Yeşil Mahalle 727. Sokak No:24 Kat:1 (Devlet Hastanesi Poliklinik Girişi Karşısı), Nazilli / Aydın'}
            </p>
          </div>
        </div>

        <!-- Çalışma Saatleri & Canlı Durum Rozeti -->
        <div class="p-4 rounded-2xl bg-brand-light/60 border border-brand-primary/15 mt-auto">
          <div class="flex items-center justify-between mb-3">
            <div class="flex items-center space-x-2">
              <svg class="w-4 h-4 text-brand-primary shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              <span class="text-xs font-bold text-brand-dark uppercase tracking-wider">Çalışma Saatleri</span>
            </div>

            <!-- Canlı Açık / Kapalı Durumu -->
            <div id="contactLiveStatusBadge" class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold border transition-colors bg-white">
              <span class="w-2 h-2 rounded-full animate-pulse bg-emerald-500"></span>
              <span id="contactLiveStatusText">Yükleniyor...</span>
            </div>
          </div>

          <div class="space-y-1.5">
            {(contact.workingHours || [
              { days: 'Pazartesi — Cumartesi', hours: '08:00 — 20:00' },
              { days: 'Pazar', hours: 'Kapalı (Randevu & İletişim)' }
            ]).map((item) => (
              <div class="flex justify-between text-xs font-medium text-brand-dark py-0.5 border-b border-gray-200/40 last:border-0">
                <span class="text-brand-muted">{item.days}</span>
                <span class="font-bold text-brand-dark">{item.hours}</span>
              </div>
            ))}
          </div>
        </div>

      </div>

      <!-- Google Harita Kartı -->
      <div class="rounded-3xl overflow-hidden shadow-xl border border-gray-100 bg-white flex flex-col h-full">
        <div class="flex-1 min-h-[280px] w-full relative">
          <iframe
            title="Klinik Google Haritalar Konumu"
            src={mapUrl}
            class="absolute inset-0 w-full h-full border-0"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <div class="p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white border-t border-gray-100">
          <div>
            <span class="text-xs font-bold text-brand-dark block">{contact.address || 'Klinik Adresi'}</span>
            {contact.addressNote && (
              <span class="text-[11px] text-brand-muted block mt-0.5">{contact.addressNote}</span>
            )}
          </div>
          <a
            href={directionsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center space-x-2 bg-brand-primary hover:bg-brand-secondary text-white text-xs font-bold py-2.5 px-4 rounded-xl shadow-sm transition-all shrink-0 font-display"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <polygon points="3 11 22 2 13 21 11 13 3 11"/>
            </svg>
            <span>Yol Tarifi Al ↗</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Satır 2: WhatsApp Randevu (sol) + E-Posta Formu (sağ) — eşit yükseklikte eşleşen çift -->
    <div class="contact-form-col grid lg:grid-cols-2 gap-8 items-stretch mt-8">

      <!-- Doğrudan WhatsApp Randevu Kartı -->
      <div class="bg-gradient-to-br from-emerald-500 via-emerald-600 to-teal-700 rounded-3xl p-6 sm:p-9 text-white shadow-2xl relative overflow-hidden flex flex-col h-full">

        <!-- Arka Plan Dekoratif Halka -->
        <div class="absolute -right-12 -top-12 w-48 h-48 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
        <div class="absolute -left-12 -bottom-12 w-48 h-48 bg-emerald-400/20 rounded-full blur-xl pointer-events-none"></div>

        <div class="relative z-10 space-y-6 text-left flex flex-col h-full">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-white text-xs font-bold uppercase tracking-wider w-fit">
            <span class="w-2 h-2 rounded-full bg-emerald-300 animate-ping"></span>
            <span>Hızlı &amp; Kolay Randevu</span>
          </div>

          <div class="space-y-2">
            <h3 class="text-2xl sm:text-3xl font-extrabold font-display leading-tight">
              WhatsApp ile Anında Randevu Alın
            </h3>
            <p class="text-emerald-50 text-sm sm:text-base leading-relaxed max-w-lg">
              Randevu oluşturmak veya tedavi hakkında bilgi almak için doğrudan WhatsApp hattımızdan bizimle iletişime geçebilirsiniz.
            </p>
          </div>

          <!-- Hazır Mesaj Önizleme Kartı -->
          <div class="bg-white/15 backdrop-blur-md rounded-2xl p-4 border border-white/20 space-y-1.5">
            <span class="text-[11px] font-bold text-emerald-200 uppercase tracking-wider block">
              Gönderilecek Hazır Mesaj:
            </span>
            <p class="text-sm font-semibold text-white italic">
              "Merhaba {doctorName}, randevu almak istiyorum."
            </p>
          </div>

          <!-- Doğrudan WhatsApp Yönlendirme Butonu -->
          <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mt-auto">
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 bg-white hover:bg-emerald-50 text-emerald-800 font-extrabold py-4 px-6 rounded-2xl shadow-xl hover:shadow-2xl transform hover:-translate-y-0.5 transition-all text-base font-display flex items-center justify-center space-x-3 text-center"
            >
              <svg class="w-6 h-6 fill-current text-emerald-600 shrink-0" viewBox="0 0 448 512" aria-hidden="true">
                <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
              </svg>
              <span>WhatsApp ile Mesaj Gönder ↗</span>
            </a>

            <a
              href={`tel:${contact.phoneClean || '905305084484'}`}
              class="bg-emerald-700/60 hover:bg-emerald-700 text-white font-bold py-4 px-6 rounded-2xl border border-emerald-400/40 backdrop-blur-md transition-all text-sm font-display flex items-center justify-center space-x-2 text-center"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <span>Doğrudan Ara</span>
            </a>
          </div>
          <p class="text-[11px] text-emerald-100">
            * Tıkladığınızda doğrudan {contact.phone || '+90 (530) 508 44 84'} WhatsApp sohbeti açılır.
          </p>
        </div>
      </div>

      <!-- Alternatif: E-Posta ile İletişim Formu -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-xl border border-gray-100 text-left flex flex-col h-full">
        <div class="border-b border-gray-100 pb-4 mb-6">
          <h3 class="text-xl font-bold text-brand-dark font-display">{contactHeading?.formTitle || 'Bize E-Posta Gönderin'}</h3>
          <p class="text-xs sm:text-sm text-brand-muted mt-1">
            Sorularınız ve talepleriniz doğrudan <strong class="text-brand-dark">{contact.email}</strong> adresimize iletilir.
          </p>
        </div>

        <form id="contact-form-element" data-recipient={recipientEmail} class="space-y-4 flex-1 flex flex-col">
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="form-name" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">Adınız Soyadınız *</label>
              <input type="text" id="form-name" name="name" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 outline-none transition-all text-sm font-medium" placeholder="Örn: Ahmet Yılmaz" />
            </div>
            <div>
              <label for="form-phone" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">Telefon Numaranız *</label>
              <input type="tel" id="form-phone" name="phone" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 outline-none transition-all text-sm font-medium" placeholder="Örn: 0530 508 44 84" />
            </div>
          </div>

          <div>
            <label for="form-email" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">E-Posta Adresiniz *</label>
            <input type="email" id="form-email" name="email" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 outline-none transition-all text-sm font-medium" placeholder="Örn: ahmet@example.com" />
          </div>

          <div class="flex-1 flex flex-col">
            <label for="form-message" class="block text-xs font-bold text-brand-dark uppercase tracking-wider mb-2">Mesajınız / Talebiniz *</label>
            <textarea id="form-message" name="message" rows="3" required class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-brand-primary focus:ring-2 focus:ring-brand-primary/20 outline-none transition-all text-sm font-medium resize-none flex-1" placeholder="Randevu talebinizi veya sorunuzu yazın..."></textarea>
          </div>

          <button
            type="submit"
            id="btnSubmitEmailForm"
            class="w-full bg-brand-primary hover:bg-brand-secondary text-white font-bold py-3.5 px-6 rounded-2xl shadow-md transform hover:-translate-y-0.5 transition-all text-sm font-display flex items-center justify-center space-x-2 cursor-pointer"
          >
            <span id="btnSubmitText">E-Posta Olarak Gönder</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </form>

        <!-- Başarı Bildirimi -->
        <div id="form-success-message" class="hidden mt-4 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-2xl text-sm font-semibold flex items-center space-x-3">
          <svg class="w-6 h-6 text-emerald-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div>
            <span class="block font-bold">Mesajınız Başarıyla İletildi!</span>
            <span class="text-xs text-emerald-700 font-normal">Kliniğimiz en kısa sürede sizinle iletişime geçecektir.</span>
          </div>
        </div>

        <!-- Hata Bildirimi -->
        <div id="form-error-message" class="hidden mt-4 p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-2xl text-sm font-semibold flex items-center space-x-3">
          <svg class="w-6 h-6 text-rose-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <div>
            <span class="block font-bold">Mesaj Gönderilemedi</span>
            <span class="text-xs text-rose-700 font-normal">Lütfen doğrudan WhatsApp hattımızdan bize ulaşın.</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- Floating WhatsApp Butonu (Ekranın Sağ Altı) -->
<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-40 bg-emerald-500 hover:bg-emerald-600 text-white p-3.5 sm:px-5 sm:py-3.5 rounded-full shadow-2xl flex items-center space-x-2.5 transition-all transform hover:scale-105 group border-2 border-white/80"
  aria-label="WhatsApp ile Randevu Al"
>
  <span class="relative flex h-3.5 w-3.5">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-200 opacity-75"></span>
    <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-white"></span>
  </span>
  <svg class="w-6 h-6 fill-current" viewBox="0 0 448 512" aria-hidden="true">
    <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
