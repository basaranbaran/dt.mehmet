---
import { clinicConfig } from '../config.js';

const { config = clinicConfig } = Astro.props;
const { brand, contact } = config;

const navItems = [
  { name: 'Anasayfa', href: '#anasayfa' },
  { name: 'Hakkımızda', href: '#hakkimizda' },
  { name: 'Tedaviler', href: '#tedaviler' },
  { name: 'Kliniğimiz', href: '#galeri' },
  { name: 'İletişim', href: '#iletisim' },
];

const base = import.meta.env.BASE_URL;

// Çift slash (//) oluşmasını engellemek için url birleştirme fonksiyonu
const cleanImageUrl = (img: string) => {
  if (!img) return '';
  const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
  const cleanImg = img.startsWith('/') ? img : '/' + img;
  return cleanBase + cleanImg;
};
---

<nav id="main-nav" class="fixed top-0 left-0 w-full z-50 py-3 bg-white/95 backdrop-blur-sm shadow-sm border-b border-gray-100 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Logo / Branding -->
      <a href="#anasayfa" class="flex items-center space-x-3 group nav-link">
        {brand.logoImage && (
          <div class="w-12 h-12 sm:w-14 sm:h-14 flex items-center justify-center bg-white rounded-2xl shadow-sm border border-gray-100 p-1 shrink-0 group-hover:border-brand-primary/40 group-hover:shadow transition-all">
            <img
              src={cleanImageUrl(brand.logoImage)}
              alt={`${brand.logoText} Logo`}
              class="w-full h-full object-contain"
              loading="eager"
            />
          </div>
        )}
        <div class="flex flex-col">
          <span class="text-lg sm:text-xl md:text-2xl font-bold tracking-wider text-brand-dark group-hover:text-brand-primary transition-colors uppercase font-display leading-tight">
            {brand.logoText}
          </span>
          <span class="text-[9px] sm:text-[10px] md:text-[11px] tracking-widest text-brand-muted uppercase font-sans font-medium">
            {brand.logoSubtext}
          </span>
        </div>
      </a>

      <!-- Desktop Navigation & Live Status -->
      <div class="hidden md:flex items-center space-x-6 lg:space-x-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="nav-link text-sm font-bold text-gray-800 hover:text-brand-primary transition-colors relative after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-brand-primary after:transition-all hover:after:w-full"
          >
            {item.name}
          </a>
        ))}
      </div>

      <!-- Action Button & Live Open Badge -->
      <div class="hidden md:flex items-center space-x-3">
        <!-- Canlı Açık / Kapalı Durumu -->
        <div id="navbarLiveStatusBadge" class="hidden xl:flex items-center space-x-1.5 px-3 py-1.5 rounded-full text-[11px] font-bold border transition-colors bg-emerald-50 text-emerald-800 border-emerald-200">
          <span class="w-2 h-2 rounded-full animate-pulse bg-emerald-500"></span>
          <span id="navbarLiveStatusText">Şu an Açık (08:00-20:00)</span>
        </div>

        <a
          href={`tel:${contact.phoneClean || '905305084484'}`}
          class="bg-[color:var(--color-phone)] hover:opacity-90 text-white font-bold py-2 px-4 lg:py-2.5 lg:px-5 rounded-full shadow-md transform hover:-translate-y-0.5 transition-all text-xs lg:text-sm font-display flex items-center shrink-0"
        >
          <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {contact.phone || '+90 (530) 508 44 84'}
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="md:hidden flex items-center space-x-2">
        <a
          href={`tel:${contact.phoneClean || '905305084484'}`}
          class="bg-emerald-50 text-emerald-700 p-2 rounded-xl border border-emerald-200 text-xs font-bold flex items-center"
          aria-label="Kliniği Ara"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
        </a>

        <button
          id="mobile-menu-btn"
          class="text-brand-dark hover:text-brand-primary focus:outline-none p-2 rounded-xl border border-gray-200 bg-gray-50 transition-colors"
          aria-label="Menüyü Aç/Kapat"
          aria-expanded="false"
        >
          <svg id="menu-open-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu" class="md:hidden border-b border-gray-200 bg-white">
    <div class="px-3 pt-2 pb-5 space-y-1 shadow-inner">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link block px-4 py-3 rounded-xl text-base font-bold text-brand-dark hover:bg-brand-light hover:text-brand-primary transition-colors"
        >
          {item.name}
        </a>
      ))}
      <div class="pt-4 pb-2 border-t border-gray-100 flex flex-col space-y-2 px-1">
        <a
          href={`https://wa.me/${contact.phoneClean || '905305084484'}`}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-5 rounded-xl text-center shadow-md transition-all text-sm font-display flex items-center justify-center space-x-2"
        >
          <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 448 512" aria-hidden="true">
            <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
          </svg>
          <span>WhatsApp'tan Randevu Al: {contact.phone || '+90 (530) 508 44 84'}</span>
        </a>

        <a
          href={`tel:${contact.landlineClean || '02563134884'}`}
          class="bg-gray-100 hover:bg-gray-200 text-brand-dark font-bold py-2.5 px-5 rounded-xl text-center transition-all text-xs font-display flex items-center justify-center space-x-2"
        >
          <svg class="w-4 h-4 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span>Sabit Hat: {contact.landlinePhone || '0 (256) 313 48 84'}</span>
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('open');
    openIcon?.classList.toggle('hidden', isOpen);
    closeIcon?.classList.toggle('hidden', !isOpen);
    btn?.setAttribute('aria-expanded', String(isOpen));
  });

  // Close menu on nav link click
  document.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (href?.startsWith('#')) {
        e.preventDefault();
        menu?.classList.remove('open');
        openIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');

        const id = href.replace('#', '');
        const el = document.getElementById(id);
        if (el) {
          const offset = window.scrollY > 20 ? 60 : 80;
          const top = el.getBoundingClientRect().top + window.scrollY - offset;
          window.scrollTo({ top, behavior: 'smooth' });
        }
      }
    });
  });

  // Scroll to top button in footer
  document.getElementById('scroll-to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
